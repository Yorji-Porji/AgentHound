[
  {
    "_comment": "FAKE but production-SHAPED `gcloud asset search-all-iam-policies --format=json` for Acme Robotics' GCP org (acmerobotics.io). Identity/permission METADATA only — no credential values. Feed to `agenthound gcp -i examples/acme-corp/gcp_iam.json`. Planted findings: terraform-deployer SA is roles/owner on acme-prod (over-privileged CI); the dev-platform group AND the GitHub Actions workload-identity principal can both impersonate terraform-deployer (serviceAccountTokenCreator / workloadIdentityUser) — a CanAssume escalation that lands on an owner SA. See README.md for the fake->real replace table.",
    "resource": "//cloudresourcemanager.googleapis.com/projects/acme-prod",
    "project": "projects/acme-prod",
    "policy": {
      "bindings": [
        {
          "role": "roles/owner",
          "members": [
            "group:org-admins@acmerobotics.io",
            "serviceAccount:terraform-deployer@acme-prod.iam.gserviceaccount.com"
          ]
        },
        { "role": "roles/viewer", "members": ["user:auditor@acmerobotics.io"] }
      ]
    }
  },
  {
    "resource": "//storage.googleapis.com/projects/_/buckets/acme-prod-artifacts",
